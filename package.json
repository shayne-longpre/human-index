{
  "name": "atlas-of-humanity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "data:acquire": "python3 -m pipelines.atlas_etl.acquire_initial_sources --output data/raw",
    "data:acquire:verticals": "python3 -m pipelines.atlas_etl.acquire_vertical_sources --output data/raw --lockfile data/registry/candidate-source-lock.json",
    "data:acquire:population-grids": "uv run python -m pipelines.atlas_etl.acquire_population_surfaces --source ghsl --years 1975 1980 1985 1990 1995 2000 2005 2010 2015 2020 2025 2030 --output data/raw --lockfile data/registry/population-surface-lock.json",
    "data:derive:population-grids": "uv run python -m pipelines.atlas_etl.population_surface --source ghsl --years 1975 1980 1985 1990 1995 2000 2005 2010 2015 2020 2025 2030 --raw-root data/raw --output data/derived/population-surfaces",
    "data:publish:population-grids": "uv run python -m pipelines.atlas_etl.publish_population_surfaces --base apps/web/public/atlas/releases/atlas-mvp-2026-09-23-r7 --derived data/derived/population-surfaces --output apps/web/public/atlas/releases/atlas-mvp-2026-10-06-r8 --raw data/raw --source-lock data/registry/source-lock.json",
    "data:acquire:economics": "uv run python -m pipelines.atlas_etl.acquire_economic_sources",
    "data:derive:economics": "uv run python -m pipelines.atlas_etl.economic_evidence",
    "data:publish:economics": "uv run python -m pipelines.atlas_etl.publish_economic_evidence --base apps/web/public/atlas/releases/atlas-mvp-2026-10-06-r8 --output apps/web/public/atlas/releases/atlas-mvp-2026-10-24-r9",
    "data:acquire:pip": "uv run python -m pipelines.atlas_etl.acquire_pip",
    "data:derive:pip": "uv run python -m pipelines.atlas_etl.pip_evidence",
    "data:publish:pip": "uv run python -m pipelines.atlas_etl.publish_pip",
    "data:acquire:pwt": "uv run python -m pipelines.atlas_etl.acquire_pwt",
    "data:derive:pwt": "uv run python -m pipelines.atlas_etl.pwt_evidence",
    "data:publish:pwt": "uv run python -m pipelines.atlas_etl.publish_pwt",
    "data:derive:institutions": "uv run python -m pipelines.atlas_etl.institutional_evidence",
    "data:publish:institutions": "uv run python -m pipelines.atlas_etl.publish_institutional_evidence",
    "data:publish:city-companions": "uv run python -m pipelines.atlas_etl.publish_city_companions",
    "data:acquire:ucdp-country-year": "uv run python -m pipelines.atlas_etl.acquire_ucdp_country_year",
    "data:publish:conflict": "uv run python -m pipelines.atlas_etl.publish_conflict_evidence",
    "data:acquire:pleiades": "uv run python -m pipelines.atlas_etl.acquire_pleiades",
    "data:review:pleiades": "uv run python -m pipelines.atlas_etl.profile_pleiades",
    "data:acquire:owid-life-expectancy": "uv run python -m pipelines.atlas_etl.acquire_owid_life_expectancy",
    "data:review:owid-life-expectancy": "uv run python -m pipelines.atlas_etl.profile_owid_life_expectancy",
    "data:acquire:religion-candidates": "uv run python -m pipelines.atlas_etl.acquire_religion_candidates",
    "data:review:religion-candidates": "uv run python -m pipelines.atlas_etl.profile_religion_candidates",
    "data:stage:world-religion": "uv run python -m pipelines.atlas_etl.stage_world_religion_project",
    "data:stage:seshat-institutions": "uv run python -m pipelines.atlas_etl.stage_seshat_institutions",
    "data:review:ccp": "uv run python -m pipelines.atlas_etl.profile_constitution_candidates",
    "data:stage:ccp-religion": "uv run python -m pipelines.atlas_etl.stage_ccp_religion",
    "data:reconcile:religion-institutions": "uv run python -m pipelines.atlas_etl.reconcile_religion_institutions",
    "data:acquire:ccp": "uv run python -m pipelines.atlas_etl.acquire_ccp",
    "data:build": "python3 -m pipelines.atlas_etl.build_mvp_release --electricity data/raw/world_bank/2026-09-20/electricity.json --life-expectancy data/raw/world_bank/2026-09-20/life-expectancy.json --population data/raw/world_bank/2026-09-20/population.json --countries data/raw/world_bank/2026-09-20/countries.json --gdp-per-capita data/raw/world_bank/2026-09-23/gdp-per-capita-constant-2015-usd.json --economics-countries data/raw/world_bank/2026-09-23/countries.json --geometry data/raw/natural_earth/v5.1.2/ne_110m_admin_0_countries.geojson --historical-population data/raw/us_census/2026-09-20/historical-est-worldpop.html --cliopatria-archive data/raw/cliopatria/v0.2.0/cliopatria.geojson.zip --cliopatria-geometry data/raw/cliopatria/v0.2.0/cliopatria_polities_only.geojson --cliopatria-license data/raw/cliopatria/v0.2.0/LICENSE.md --historical-cities data/raw/reba_cities/2016/modelskiAncientV2.csv --historical-cities-metadata data/raw/reba_cities/2016/modelski-ancient.metadata.json --un-wpp data/raw/un_wpp/2024/WPP2024_Demographic_Indicators_Medium.csv.gz --reconciliation-decisions data/decisions/reconciliation-decisions-v1.json --output apps/web/public/atlas/releases/atlas-mvp-2026-09-23-r7 --lockfile data/registry/source-lock.json",
    "data:decisions": "python3 -m pipelines.atlas_etl.build_reconciliation_decisions --policy data/decisions/reconciliation-policy-v1.json --cities data/review/historical-city-crosswalk-candidates.json --borders data/review/cliopatria-topology-pilot.json --cliopatria data/raw/cliopatria/v0.2.0/cliopatria_polities_only.geojson --output data/decisions/reconciliation-decisions-v1.json",
    "data:review:cshapes": "uv run python -m pipelines.atlas_etl.profile_cshapes --input data/raw/cshapes/2.0/CShapes-2.0.geojson --codebook data/raw/cshapes/2.0/CShapes-2.0_Codebook.pdf --output data/review/cshapes-2.0-profile.json",
    "data:review:verticals": "uv run python -m pipelines.atlas_etl.profile_vertical_sources --raw-root data/raw --candidate-lock data/registry/candidate-source-lock.json --output data/review/vertical-source-profiles.json",
    "data:review:hyde": "uv run python -m pipelines.atlas_etl.profile_hyde --license data/raw/hyde/3.5/License.txt --readme data/raw/hyde/3.5/readme_HYDE_3.5.txt --sample data/raw/hyde/3.5/base/10000BC_pop.zip --output data/review/hyde-3.5-sample-profile.json",
    "data:review:queue": "python3 -m pipelines.atlas_etl.build_review_queue --topology data/review/cliopatria-topology-pilot.json --cities data/review/historical-city-crosswalk-candidates.json --decisions data/decisions/reconciliation-decisions-v1.json --output apps/web/public/atlas/review/review-queue.json",
    "data:review:cities": "uv run python -m pipelines.atlas_etl.review_city_crosswalk --input-dir data/raw/reba_cities/2016 --output data/review/historical-city-crosswalk-candidates.json",
    "data:review:topology": "uv run python -m pipelines.atlas_etl.review_cliopatria_topology --input data/raw/cliopatria/v0.2.0/cliopatria_polities_only.geojson --output data/review/cliopatria-topology-pilot.json",
    "data:review:wpp": "uv run python -m pipelines.atlas_etl.profile_un_wpp --input data/raw/un_wpp/2024/WPP2024_Demographic_Indicators_Medium.csv.gz --output data/review/un-wpp-2024-profile.json",
    "test": "vitest run --config apps/web/vite.config.ts",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "test:watch": "vitest --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@loaders.gl/core": "4.4.5",
    "maplibre-gl": "6.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.10.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.13.0",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}
